# Hermes local configuration repository
#
# Default deny: this directory contains secrets, browser profiles, databases,
# logs, runtime state, caches, and generated artifacts. Only explicitly
# allowlisted knowledge/configuration text files should be versioned.

*

# Git metadata for this local config repo
!.gitignore
!.gitattributes
!README.md

# Core identity / memory layer
!SOUL.md
!AGENTS.md
!memories/
!memories/*.md

# Skill knowledge layer
!skills/
!skills/**/
!skills/**/SKILL.md
!skills/**/DESCRIPTION.md
!skills/**/PORT_NOTES.md
!skills/.hub/hermes-skill-manifest.json

# Historical/reference files often contain raw session records, example tokens,
# URLs with access tokens, or copied credentials. Add specific clean references
# later after review instead of allowlisting them by pattern.
skills/.archive/
skills/**/references/
skills/**/tests/
skills/**/workflows/

# Lightweight docs/templates that explain local behavior
!docs/
!docs/**/
!docs/**/*.md
!templates/
!templates/**/
!templates/**/*.md
!templates/gate_policy_v2_8.json
!templates/inbox_v2_8.json
!templates/outbox_v2_8.json
!templates/review_v2_8.json
!.tours/
!.tours/.gitkeep

# Task verification runtime
!scripts/
!scripts/compile-task.py
!scripts/dispatch-task.py
!scripts/gate-policy.py
!scripts/review-task.py
!scripts/run-ledger.py
!scripts/run-task-gate.py
!scripts/opencode-agent.py
!scripts/task-status.py
!scripts/verify-task.py
!scripts/task-run-projection.py
!scripts/task-run-projection-build.py
!scripts/task-run-projection-acceptance.py

# Tests for local collaboration harness scripts
!tests/
!tests/test_opencode_agent.py
!tests/test_run_ledger_default_paths.py
!tests/test_task_run_projection.py
!tests/test_task_run_projection_build.py
!tests/test_task_run_projection_acceptance.py

# Configuration layer — the deployment skeleton
!config.yaml
!config/
!config/*.yaml
!config/*.json

# Bootstrap scripts
!bin/
!bin/*

# macOS launchd service definitions (for gateway auto-start)
!launchd/
!launchd/*.plist

# Never track nested code repo contents from the parent config repo
hermes-agent/

# Explicit high-risk runtime/secret areas, kept here for readability
.env*
auth*.json
*.db
*.db-*
*.sqlite
*.sqlite-*
chrome-profile/
logs/
sessions/
cron/
cache/
artifacts/
audio_cache/
image_cache/
state/
task_cards/
subagents/
temp_vision_images/
venv/
node_modules/
bin/tirith
